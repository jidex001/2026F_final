name: Validate Forensic Workflows and Scripts

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]

jobs:
  validate-ci:
    name: Lint and Validate
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Install ShellCheck
        run: |
          sudo apt-get update
          sudo apt-get install -y shellcheck

      - name: Validate Shell Scripts
        run: |
          echo "Checking shell scripts for syntax errors and best practices..."
          # Scans any .sh files in the repository for potential bugs
          find . -name "*.sh" -exec shellcheck {} + || echo "No .sh scripts found or check completed with notes."

      - name: Validate GitHub Actions Workflows (`actionlint`)
        uses: reviewdog/action-actionlint@v1
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          reporter: github-pr-check
          level: error
